{
  "manifestVersion": 2,
  "id": "traffic-light",
  "name": "Traffic Light",
  "version": "0.15.0",
  "description": "Observe agent activity, sync shared capabilities, and connect agents on demand.",
  "license": "MIT-0",
  "engines": {
    "orca": ">=1.4.261"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "storage:own"
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "traffic-light",
        "title": "Traffic Light",
        "icon": "activity",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "hooks": [
      {
        "event": "agent.tool.before"
      },
      {
        "event": "agent.tool.after"
      }
    ],
    "settings": [
      {
        "key": "nativeActivity",
        "title": "Show terminal agent status",
        "description": "Lists agent states in the focused workspace through Orca’s public plugin API. Terminal tool hooks and shared runner calls appear separately in Activity.",
        "type": "boolean",
        "default": false
      }
    ]
  }
}
